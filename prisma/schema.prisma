generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Пользователь: авторизация по телефону
model User {
  id        String   @id @default(uuid())
  phone     String   @unique @db.VarChar(20) // +79991234567
  name      String?  @db.VarChar(100)
  pass      String   @db.VarChar(100)
  birthDate DateTime? @db.Date // только дата, без времени

  dreams    Dream[]
  chats     Chat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// Чат: личный или групповой диалог с ботом
model Chat {
  id        String   @id @default(uuid())
  title     String   @db.VarChar(100) // "Мои сны", "Семейный чат" и т.д.
  type      ChatType @default(INDIVIDUAL) // индивидуальный или групповой
  status    ChatStatus @default(ACTIVE)  // активный или архивный

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages  Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chats")
}

// Сообщение в чате
model Message {
  id        String     @id @default(uuid())
  chatId    String
  chat      Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)

  role      MessageRole
  content   String     @db.Text // текст сообщения
  audioUrl  String?    @db.VarChar(500) // опционально: голосовое сообщение
  metadata  Json?      // доп. данные: например, { "ttsUsed": true, "source": "telegram" }

  createdAt DateTime   @default(now())

  @@map("messages")
}

// Сон: текст + интерпретация от ИИ
model Dream {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  dreamText     String   @db.Text
  interpretation String?  @db.Text

  audioUrl      String?  @db.VarChar(500)
  ttsAudioUrl   String?  @db.VarChar(500)

  createdAt     DateTime @default(now())

  @@map("dreams")
}

// ENUMs
enum ChatType {
  INDIVIDUAL
  GROUP
}

enum ChatStatus {
  ACTIVE
  ARCHIVED
}

enum MessageRole {
  USER      // сообщение от пользователя
  ASSISTANT // сообщение от бота (ИИ, сонник и т.д.)
}